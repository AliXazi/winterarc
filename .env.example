# Copy to .env and fill — never commit .env
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=change-me-to-random-32-chars
# Local sqlite (default) — for prod Render sets DATABASE_URL automatically
DATABASE_URL=sqlite+aiosqlite:///./winterarc.db
# For prod Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
